# Maintainer: Sami Kalliomäki <sami@kalliomaki.me>
pkgname=ipp-duplexd
# read straight from the crate; this PKGBUILD only builds the working tree
pkgver=$(sed -n 's/^version = "\(.*\)"/\1/p' "$startdir/../../Cargo.toml" | head -1)
pkgrel=1
pkgdesc="Manual duplex printing via a loopback virtual IPP printer"
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qpdf' 'gcc-libs')
makedepends=('cargo')
# The tarball is produced from the working tree by ../build-arch.sh; its name
# carries no version, so it can never disagree with pkgver
source=("$pkgname.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname"
    export CARGO_TARGET_DIR=target
    cargo build --release --locked
}

package() {
    cd "$pkgname"
    install -Dm755 target/release/ipp-duplexd "$pkgdir/usr/bin/ipp-duplexd"
    install -Dm755 target/release/ipp-duplexd-setup "$pkgdir/usr/bin/ipp-duplexd-setup"
    install -Dm644 packaging/ipp-duplexd.service "$pkgdir/usr/lib/systemd/user/ipp-duplexd.service"
    install -Dm644 packaging/ipp-duplexd.conf.example "$pkgdir/usr/share/doc/$pkgname/ipp-duplexd.conf.example"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
